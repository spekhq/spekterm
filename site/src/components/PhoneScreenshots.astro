---
/**
 * spekterm for Android's phone screenshots, side by side, with one caption. They are imported by the capture
 * script from the app's Google Play listing at a release tag (project-website, `scripts/lib/phone-shots.mjs`);
 * their content is illustrative, and the caption says so.
 */
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import { useStrings } from '../i18n'

interface Props {
  shots: { src: ImageMetadata; alt: string }[]
  caption?: string
}

const { shots, caption } = Astro.props
const t = useStrings(Astro.locals.starlightRoute.lang)
---

<figure class="phones not-content">
  <div class="row">
    {shots.map(({ src, alt }) => <Image src={src} alt={alt} widths={[360, 540, 1080]} sizes="15rem" />)}
  </div>
  <figcaption>{caption ? `${caption} ` : ''}{t('landing.illustrative')}</figcaption>
</figure>

<style>
  .phones {
    margin: 2rem 0;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.25rem;
  }
  /* At most three to a row (two on a narrow screen), so five fall into three and two, not two, two and one. */
  .row img {
    width: min(15rem, calc((100% - 2.5rem) / 3));
    height: auto;
    border-radius: 1.25rem;
    border: 1px solid var(--sl-color-gray-5);
    box-shadow: 0 1.5rem 3rem -1rem rgb(0 0 0 / 0.5);
  }
  @media (max-width: 40rem) {
    .row img {
      width: calc((100% - 1.25rem) / 2);
    }
  }
  figcaption {
    margin-top: 0.75rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
    text-align: center;
  }
</style>
