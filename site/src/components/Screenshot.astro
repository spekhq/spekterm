---
/**
 * A full-width app screenshot with its caption. Every screenshot comes from
 * `scripts/capture-screenshots.mjs` (project-website); its content is illustrative, and the caption
 * says so.
 */
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import { useStrings } from '../i18n'

interface Props {
  src: ImageMetadata
  alt: string
  caption?: string
}

const { src, alt, caption } = Astro.props
const t = useStrings(Astro.locals.starlightRoute.lang)
---

<figure class="screenshot not-content">
  <Image src={src} alt={alt} widths={[960, 1440, 2880]} sizes="(min-width: 72rem) 72rem, 100vw" />
  <figcaption>{caption ? `${caption} ` : ''}{t('landing.illustrative')}</figcaption>
</figure>

<style>
  .screenshot {
    margin: 2rem 0;
  }
  .screenshot img {
    width: 100%;
    height: auto;
    border-radius: 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    box-shadow: 0 1.5rem 3rem -1rem rgb(0 0 0 / 0.5);
  }
  figcaption {
    margin-top: 0.75rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
    text-align: center;
  }
</style>
