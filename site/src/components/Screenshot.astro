---
/**
 * A full-width app screenshot with its caption. Every screenshot comes from
 * `scripts/capture-screenshots.mjs` (project-website); its content is illustrative, and the caption
 * says so.
 */
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import { useStrings } from '../i18n'

interface Props {
  src: ImageMetadata
  alt: string
  caption?: string
  /**
   * Wider than the text column, up to 72rem — the captures are 1440 CSS pixels of app UI, unreadable
   * at the column's width. Only on pages without a sidebar (the landing page): the figure is centered
   * on the column, which is centered in the viewport only there.
   */
  wide?: boolean
}

const { src, alt, caption, wide = false } = Astro.props
const t = useStrings(Astro.locals.starlightRoute.lang)
---

<figure class:list={['screenshot', 'not-content', { wide }]}>
  <Image src={src} alt={alt} widths={[960, 1440, 2880]} sizes="(min-width: 72rem) 72rem, 100vw" />
  <figcaption>{caption ? `${caption} ` : ''}{t('landing.illustrative')}</figcaption>
</figure>

<style>
  .screenshot {
    margin: 2rem 0;
  }
  .wide {
    position: relative;
    left: 50%;
    width: min(72rem, 100vw - 3rem);
    transform: translateX(-50%);
  }
  .screenshot img {
    width: 100%;
    height: auto;
    border-radius: 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    box-shadow: 0 1.5rem 3rem -1rem rgb(0 0 0 / 0.5);
  }
  figcaption {
    margin-top: 0.75rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
    text-align: center;
  }
</style>
