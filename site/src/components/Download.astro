---
/**
 * The download call to action. It links to the latest release page, never to a file: asset names
 * carry the version (build-identity), and the site carries no version of its own (project-website).
 * The platform status is stated next to it, word for word from the dictionary.
 */
import { LinkButton } from '@astrojs/starlight/components'
import { useStrings } from '../i18n'

const t = useStrings(Astro.locals.starlightRoute.lang)
---

<div class="download not-content">
  <LinkButton href="https://github.com/spekhq/spekterm/releases/latest" icon="download" iconPlacement="start">
    {t('landing.download')}
  </LinkButton>
  <p class="platforms">{t('landing.platforms')}</p>
  <p class="note">{t('landing.downloadNote')} {t('landing.early')}</p>
</div>

<style>
  .download {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    margin: 2rem 0;
    text-align: center;
  }
  .platforms {
    margin: 0.5rem 0 0;
    color: var(--sl-color-white);
  }
  .note {
    margin: 0;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
</style>
